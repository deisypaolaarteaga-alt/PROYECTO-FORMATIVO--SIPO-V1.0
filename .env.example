# ============ SUPABASE ============
# Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Supabase Dashboard → Settings → API → anon (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Dashboard → Settings → API → service_role (NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=

# ============ BASE DE DATOS ============
# Supabase Dashboard → Project Settings → Database → Database password
SUPABASE_DB_PASSWORD=

# Pooler Transaction mode (puerto 6543)
SUPABASE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
SUPABASE_DB_PORT=6543

# ============ CIFRADO ============
# Clave AES-256 para cifrar datos sensibles en BD (API keys de usuarios).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OBLIGATORIA — el servidor no arranca sin ella.
ENCRYPTION_KEY=

# ============ APP ============
NEXT_PUBLIC_APP_URL=http://localhost:3000
