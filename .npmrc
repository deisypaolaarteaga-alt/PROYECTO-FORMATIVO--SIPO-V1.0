# pnpm + Next.js 16 en Windows
# node-linker=hoisted: copia archivos en lugar de symlinks (requerido en Windows sin permisos de admin)
node-linker=hoisted

# shamefully-hoist: estructura node_modules plana como npm (requerido por Next.js)
shamefully-hoist=true

# Evita que pnpm pida confirmación para instalar paquetes con scripts de build
# (esbuild, @swc/core, sharp los necesitan en Windows)
ignore-scripts=false
